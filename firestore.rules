rules_version = '2';

// 기윤실교사모임 앱 권한 규칙
// ---------------------------------------------------------------
// 누가 무엇을 할 수 있는지는 화면이 아니라 "여기서" 결정된다.
// 화면에서 버튼을 숨겨도, 이 규칙을 통과하지 못하면 서버가 거절한다.
//
// 역할은 roles/{구글이메일} 문서의 role 값으로 정한다.
//   admin  : 모든 편집 + 권한 관리
//   editor : 캘린더·기도문 편집, 후원자 명단 보기
//   member : 후원자 명단 보기
//   (등록 안 됨) : 캘린더·기도문·소식지 보기만
//
// js/store.js 의 PERMISSIONS 와 항상 같게 유지할 것.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(db)/documents/roles/$(myEmail()))
        && get(/databases/$(db)/documents/roles/$(myEmail())).data.role in roles;
    }
    // 수정 기록은 반드시 본인 이메일로 남게 한다 (누가 고쳤는지 추적).
    function stampedByMe() {
      return request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
    }
    function shortText(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    match /roles/{email} {
      allow read: if signedIn() && (email == myEmail() || hasRole(['admin']));
      allow create, update: if hasRole(['admin'])
        && request.resource.data.role in ['admin', 'editor', 'member']
        && stampedByMe();
      // 관리자가 실수로 자기 자신을 지워 아무도 관리자가 없게 되는 일을 막는다.
      allow delete: if hasRole(['admin']) && email != myEmail();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update: if hasRole(['admin', 'editor'])
        && stampedByMe()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && shortText('title', 100)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && shortText('place', 200)
        && shortText('memo', 2000);
      allow delete: if hasRole(['admin', 'editor']);
    }

    match /prayers/{id} {
      allow read: if true;
      allow create, update: if hasRole(['admin', 'editor']) && stampedByMe()
        && shortText('title', 100) && shortText('body', 10000);
      allow delete: if hasRole(['admin', 'editor']);
    }

    match /newsletters/{id} {
      allow read: if true;
      allow create, update: if hasRole(['admin']) && stampedByMe();
      allow delete: if hasRole(['admin']);
    }

    // 후원자 명단은 개인정보이므로 등록된 사람만 볼 수 있다.
    match /donors/{id} {
      allow read: if hasRole(['admin', 'editor', 'member']);
      allow create, update: if hasRole(['admin']) && stampedByMe();
      allow delete: if hasRole(['admin']);
    }
  }
}
